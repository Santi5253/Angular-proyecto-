{
  "name": "backend-caja-cigarreria",
  "version": "1.0.0",
  "description": "Back-end sistema caja registradora cigarreria (Express + TypeScript + pg). Vive en la misma raiz del front-end pero POR FUERA de src.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:init": "node scripts/init-db.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9.2"
  }
}
